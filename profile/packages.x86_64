# Base System & Boot
base
linux-zen
linux-zen-headers
linux-firmware
networkmanager
syslinux
grub
efibootmgr
sudo
vim
git

# Minimal KDE Plasma 6 (Zero Bloat)
xorg-xwayland
plasma-desktop
plasma-nm
plasma-pa
kscreen
powerdevil
sddm
dolphin
konsole
kate
ark
spectacle
gwenview
xdg-desktop-portal-kde
qt6-wayland

# Audio (PipeWire + HDR Capture Support)
pipewire
pipewire-alsa
pipewire-pulse
pipewire-jack
wireplumber

# GPU Drivers (AMD, Intel, NVIDIA + 32-bit Vulkan for Steam/Proton)
mesa
lib32-mesa
vulkan-radeon
lib32-vulkan-radeon
vulkan-intel
lib32-vulkan-intel
nvidia-dkms
nvidia-utils
lib32-nvidia-utils
vulkan-icd-loader
lib32-vulkan-icd-loader

# Gaming Stack (Steam Runtime, Gamescope Deck UI, MangoHud, GameMode)
steam
gamescope
mangohud
lib32-mangohud
gamemode
lib32-gamemode
lutris
wine-staging
winetricks

# Office Suite (MS Office Ribbon Look-Alike Base) & Fonts
libreoffice-fresh
ttf-liberation
noto-fonts
noto-fonts-emoji

[options]
HoldPkg     = pacman glibc
Architecture = auto
Color
CheckSpace
ParallelDownloads = 5
SigLevel    = Required DatabaseOptional
LocalFileSigLevel = Optional

[core]
Include = /etc/pacman.d/mirrorlist

[extra]
Include = /etc/pacman.d/mirrorlist

[multilib]
Include = /etc/pacman.d/mirrorlist

[chaotic-aur]
SigLevel = Never
Server = https://cdn-mirror.chaotic.cx/$repo/$arch
