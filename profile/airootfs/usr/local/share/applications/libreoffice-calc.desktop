[Desktop Entry]
Version=1.0
Terminal=false
Icon=/usr/share/pixmaps/winx-excel.svg
Type=Application
Categories=Office;Spreadsheet;
Exec=libreoffice --calc %U
MimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.ms-excel;application/vnd.oasis.opendocument.spreadsheet;
Name=WinX Excel
GenericName=Spreadsheet
Comment=Create and edit spreadsheets (.xlsx, .xls)
StartupWMClass=libreoffice-calc
