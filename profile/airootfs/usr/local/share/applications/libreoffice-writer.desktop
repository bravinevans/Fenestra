[Desktop Entry]
Version=1.0
Terminal=false
Icon=/usr/share/pixmaps/winx-word.svg
Type=Application
Categories=Office;WordProcessor;
Exec=libreoffice --writer %U
MimeType=application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/msword;application/vnd.oasis.opendocument.text;
Name=WinX Word
GenericName=Word Processor
Comment=Create and edit Word documents (.docx, .doc)
StartupWMClass=libreoffice-writer
