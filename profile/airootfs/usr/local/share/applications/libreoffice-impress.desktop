[Desktop Entry]
Version=1.0
Terminal=false
Icon=/usr/share/pixmaps/winx-powerpoint.svg
Type=Application
Categories=Office;Presentation;
Exec=libreoffice --impress %U
MimeType=application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.ms-powerpoint;application/vnd.oasis.opendocument.presentation;
Name=WinX PowerPoint
GenericName=Presentation
Comment=Create and edit presentations (.pptx, .ppt)
StartupWMClass=libreoffice-impress
